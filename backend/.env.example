# Database
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# DigitalOcean Spaces
# Go to Spaces → Manage Keys → Create Access Key
DO_SPACES_KEY=your_spaces_access_key_id
DO_SPACES_SECRET=your_spaces_secret_key
# Your bucket's region slug, e.g. lon1, nyc3, sfo3
DO_SPACES_REGION=lon1
DO_SPACES_BUCKET=your-bucket-name
# Format: https://<region>.digitaloceanspaces.com
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com

# CommunitAI Agent
AGENT_ENDPOINT_URL=https://your-agent-service.ondigitalocean.app
AGENT_API_KEY=your_agent_api_key

# AI Services
GRADIENT_API_KEY=your_gradient_api_key
GRADIENT_MODEL_ACCESS_KEY=your_gradient_model_access_key
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key

# Auth
JWT_SECRET=change-me-in-production
ALLOWED_ORIGINS=https://communit-ai.vercel.app

# Demo account
DEMO_EMAIL=demo@communitai.app
DEMO_PASSWORD=demo1234
