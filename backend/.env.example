# Database
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_JQvkXZAzHE72@ep-nameless-term-aby1381u-pooler.eu-west-2.aws.neon.tech/neondb?ssl=require

# Cloudflare R2 Storage
# Step 1: Go to R2 → Manage R2 API Tokens → Create API Token → paste the "Access Key ID" below
DO_SPACES_KEY=PASTE_ACCESS_KEY_ID_HERE

# Step 2: From the same screen, paste the "Secret Access Key" below
DO_SPACES_SECRET=PASTE_SECRET_ACCESS_KEY_HERE

# Step 3: Leave this as-is
DO_SPACES_REGION=auto

# Step 4: This is your bucket name — already created, leave it
DO_SPACES_BUCKET=communitai-storage

# Step 5: Go to R2 overview page, copy your Account ID (top right), paste it in the URL below replacing ACCOUNT_ID
DO_SPACES_ENDPOINT=https://PASTE_ACCOUNT_ID_HERE.r2.cloudflarestorage.com

# CommunitAI Agent
AGENT_ENDPOINT_URL=https://your-agent-endpoint.do-ai.run
AGENT_API_KEY=your_agent_api_key

# AI Services
GRADIENT_API_KEY=your_gradient_api_key
OPENAI_API_KEY=your_openai_api_key
